# Unity-generated caches, local settings and build output.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Dd]ist/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity regenerates these IDE projects in the project root.
# Handwritten Tools/**/*.csproj files must remain versioned.
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.pidb
/*.booproj
/.vs/
/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output from all standalone .NET verification tools.
/Tools/**/bin/
/Tools/**/obj/
/Tools/**/TestResults/

# JavaScript tooling dependencies and local caches (keep lockfiles).
node_modules/
/.npm/
/.cache/

# Runtime logs and process IDs; curated reports and fixtures stay trackable.
# Already tracked historical logs are not removed by these rules.
*.log
*.pid
*.pid.lock

# Release binaries are generated; keep the small verification manifests.
/Releases/*
!/Releases/*.manifest.json

# Local environment, crash dumps and editor/OS temporary files.
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
/sysinfo.txt
/mono_crash.*
/crash.dmp
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Keep Assets (including .meta), Packages, ProjectSettings, Tools sources,
# compressed test fixtures and the curated Verification reports/assets.

# Local isolated verification workspaces.
/.tmp/
/tmp/
/.tmp-*
/.scratch-*

# Full raw initial training stays local; exact lossless .json.gz and hash manifest are versioned.
/Verification/stochastic-bots-training-initial.json
/Verification/stochastic-bots-study-postclip-initial.json
/Verification/stochastic-bots-study-cascade-sensitivity-k070.json

/Verification/stochastic-bots-study-cascade-confirm-k075-k085.json

/Verification/stochastic-bots-study-flow-sensitivity-k110.json

/Verification/stochastic-bots-study-long-fast-sensitivity-k110.json

/Verification/stochastic-bots-study-flow-confirm-k105-k108.json

/Verification/stochastic-bots-study-long-fast-confirm-k104.json
