<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(CoreRoot)/*.cs" /></ItemGroup>
  <Target Name="RequireFrozenCore" BeforeTargets="PrepareForBuild" Condition="'$(CoreRoot)' == ''">
    <Error Text="Run Run.ps1 to provide the frozen Core source tree." />
  </Target>
</Project>
